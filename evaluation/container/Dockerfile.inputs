# The inputs image (the service `inputs` of evaluation/compose.yaml): every
# pinned input of the evaluation, fetched by its pin when the image is
# built. Every other image takes what it needs from it at its own build
# (the additional context `inputs: service:inputs`); nothing is fetched
# when a service runs.
#
#   /inputs/macro-benchmark/projects/<name>   the 30 projects (fetch.py macro)
#   /inputs/tools/<name>                      the trees of the prior tools' images (fetch.py tools)
#   /inputs/corpus/                           the corpus of RQ3 (corpus.py fetch): cache/ holds the
#                                             archives, work/, dypybench/ and large/ the unpacked trees
#   /inputs/corpus/dypybench-traces/          DyPyBench's traces (trace_recall.py fetch)
#   /inputs/rts/export/                       the export of the NameRTS clones (rts.py fetch, export)
#
# Each input is a stage of its own, so that a change of one input fetches
# only that input again. A step fails, and so the build, if a source is not
# its pin: git checks the commit, the scripts the SHA-256 and size of each
# file. git and the downloads run only here, as a user without rights, with
# git's hooks, submodules and configuration off (fetch.py); nothing fetched
# is installed, imported or run. The clones of RQ4 (with .git) stay in their
# stage: only their export reaches the image.
#
# The context is the repository; Dockerfile.inputs.dockerignore lets in only
# the files that the steps read. PYTHON_IMAGE is the Python image by digest:
# its default is x-python-image of compose.yaml (tests/test_compose.py
# checks that they are equal), so the target maintain builds without
# arguments.
ARG PYTHON_IMAGE=python:3.14-slim@sha256:9aaa474097d094040649f2162a627c0049b408f52138d980916788d80f04802f

# The base of every fetch: the Python image, git and the CA certificates.
FROM ${PYTHON_IMAGE} AS network
RUN apt-get update \
    && apt-get install --yes --no-install-recommends git ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 fetcher \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp \
        --shell /usr/sbin/nologin fetcher \
    && mkdir /inputs && chown 10001:10001 /inputs
ENV HOME=/tmp PYTHONDONTWRITEBYTECODE=1
WORKDIR /repo

# Not part of the inputs: the image of the maintenance commands that need
# the network (pin.py requirements and deps, draw.py, the manifests), with
# uv for pin.py. evaluation/README.md, "Maintenance", says how to run it.
FROM network AS maintain
RUN pip install --no-cache-dir uv

FROM network AS macro
USER 10001:10001
COPY macro-benchmark/projects.py macro-benchmark/projects.toml macro-benchmark/
COPY evaluation/container/fetch.py evaluation/container/
RUN python3 -I -B evaluation/container/fetch.py macro /inputs/macro-benchmark/projects

FROM network AS tools
USER 10001:10001
COPY evaluation/tools/*.py evaluation/tools/
COPY evaluation/container/fetch.py evaluation/container/
RUN python3 -I -B evaluation/container/fetch.py tools /inputs/tools

FROM network AS corpus
USER 10001:10001
COPY evaluation/rq3-scale/corpus.py evaluation/rq3-scale/
COPY evaluation/rq3-scale/corpus/pypi-top-100.json evaluation/rq3-scale/corpus/dypybench.json \
    evaluation/rq3-scale/corpus/
RUN python3 -I -B evaluation/rq3-scale/corpus.py fetch \
        --manifest evaluation/rq3-scale/corpus/pypi-top-100.json \
        --cache /inputs/corpus/cache --work /inputs/corpus/work \
    && python3 -I -B evaluation/rq3-scale/corpus.py fetch \
        --manifest evaluation/rq3-scale/corpus/dypybench.json \
        --cache /inputs/corpus/cache --work /inputs/corpus/dypybench
# The third part in a step of its own: the steps above keep their cache.
COPY evaluation/rq3-scale/corpus/large-projects.json evaluation/rq3-scale/corpus/
RUN python3 -I -B evaluation/rq3-scale/corpus.py fetch \
        --manifest evaluation/rq3-scale/corpus/large-projects.json \
        --cache /inputs/corpus/cache --work /inputs/corpus/large

# trace_recall.py loads the scorer, which loads the validator of the
# micro-benchmark (the submodule PyCG): Python 3.14.
FROM network AS traces
USER 10001:10001
COPY macro-benchmark/projects.py macro-benchmark/check.py macro-benchmark/trace.py \
    macro-benchmark/sites.py macro-benchmark/ledger.py macro-benchmark/
COPY PyCG/micro-benchmark/validate.py PyCG/micro-benchmark/
COPY evaluation/common/ evaluation/common/
COPY evaluation/container/tool_job.py evaluation/container/
COPY evaluation/rq3-scale/table.py evaluation/rq3-scale/robustness.py \
    evaluation/rq3-scale/corpus.py evaluation/rq3-scale/
COPY evaluation/rq1-accuracy/trace_recall.py evaluation/rq1-accuracy/
RUN python3 -I -B evaluation/rq1-accuracy/trace_recall.py fetch --work /inputs/corpus

FROM network AS rts
USER 10001:10001
COPY macro-benchmark/projects.py macro-benchmark/draw.py macro-benchmark/
COPY evaluation/common/ evaluation/common/
COPY evaluation/rq4-test-selection/rts.py evaluation/rq4-test-selection/
COPY evaluation/rq4-test-selection/corpus/rts.json evaluation/rq4-test-selection/corpus/
RUN python3 -I -B evaluation/rq4-test-selection/rts.py fetch --work /tmp/rts \
    && python3 -I -B evaluation/rq4-test-selection/rts.py export --work /tmp/rts \
        --out /inputs/rts/export

# The image: the plain Python image (the base of the runner, so its layers
# are shared) and the inputs, without git. Its shell and Python serve the
# commands of the README that read the inputs (a copy of the sources for
# reading, pin.py trees).
FROM ${PYTHON_IMAGE}
COPY --from=macro /inputs/macro-benchmark /inputs/macro-benchmark
COPY --from=tools /inputs/tools /inputs/tools
COPY --from=corpus /inputs/corpus /inputs/corpus
COPY --from=traces /inputs/corpus/dypybench-traces /inputs/corpus/dypybench-traces
COPY --from=rts /inputs/rts/export /inputs/rts/export
WORKDIR /repo
