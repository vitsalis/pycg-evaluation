# The image of the questions (evaluation/compose.yaml): CPython of the
# official image, git, and the inputs that the questions read, from the
# inputs image (Dockerfile.inputs: the additional context `inputs`): the
# sources of the macro-benchmark, the corpus of RQ3 with DyPyBench's
# traces, and the export of RQ4. git reads only our own repositories,
# mounted read-only: the commit under test, and the `pycg` package of a
# commit (common/engine.py). PyCG, the runner and the scorer come from the
# mounts.
#
# PYTHON_IMAGE is the base image by digest; compose.yaml passes it, and it
# has no default, so a build without it fails. /tool-graphs is the mount
# point of the volume of the prior tools' graphs of rq1-trace and rq4
# (compose.yaml): a new volume takes its mode, so that any user writes
# there.
ARG PYTHON_IMAGE
FROM ${PYTHON_IMAGE}

RUN apt-get update \
    && apt-get install --yes --no-install-recommends git \
    && rm -r /var/lib/apt/lists/* \
    && mkdir -m 1777 /tool-graphs \
    && groupadd --gid 10001 runner \
    && useradd --uid 10001 --gid 10001 --no-create-home --home-dir /tmp \
        --shell /usr/sbin/nologin runner

COPY --from=inputs /inputs/macro-benchmark /inputs/macro-benchmark
COPY --from=inputs /inputs/corpus /inputs/corpus
COPY --from=inputs /inputs/rts /inputs/rts

USER 10001:10001
WORKDIR /tmp
